    function parseCountryData(doc) {
        const data = [];
        const seenCountries = new Set();
        const tables = doc.querySelectorAll('table');

        tables.forEach(table => {
            const headerRow = table.querySelector('tr');
            if (!headerRow) return;

            const headers = Array.from(headerRow.querySelectorAll('th, td')).map(th =>
                th.textContent.trim()
            ).filter(h => h);

            if (headers.includes('Country') || headers.includes('Clicks')) {
                const rows = Array.from(table.querySelectorAll('tr')).slice(1);

                rows.forEach(row => {
                    const cells = Array.from(row.querySelectorAll('td, th'));

                    if (cells.length >= 2) {
                        const rowData = {};

                        cells.forEach((cell, index) => {
                            if (headers[index]) {
                                rowData[headers[index]] = cell.textContent.trim();
                            }
                        });

                        const hasData = Object.values(rowData).some(val => val && val !== '' && val !== '-');
                        const countryKey = rowData['Country'];

                        if (hasData && countryKey && !seenCountries.has(countryKey)) {
                            if (countryKey.toLowerCase() !== 'total') {
                                seenCountries.add(countryKey);
                                data.push(rowData);
                            }
                        }
                    }
                });
            }
        });

        return data;
    }

