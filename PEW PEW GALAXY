        watermarkText: 'TITAN GEL',
        bgGif: 'https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExdXBocGVkYjJhdDd5NHoybGN6MzdxenJsZGhqZW9ka2M5YXYzNTJyeiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/pVWuLuV1JESZJdebkI/giphy.gif'
    };

    let currentDateRange = { from: '', to: '' };
    let cachedCampaignResults = null;

    const campaigns = [
        { id: '946',  name: 'JLG - v1 - AU/IE/FR/IT' },
        { id: '957',  name: 'NT - AU/IT' },
        { id: '989',  name: 'ONF - NO CAP - AU/FR/IT/NZ' },
