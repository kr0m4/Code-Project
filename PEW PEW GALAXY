        { id: '1038', name: 'GF - XHP - NO CAP - DE/NL/BE/AT' },
        { id: '1039', name: 'GF - XXHP - NO CAP - CH/SE/NO/DK/FI' },
    ];

    // ── Watermark ──────────────────────────────────────────────
    function createWatermark() {
        const el = document.createElement('div');
        el.textContent = CONFIG.watermarkText;
        el.style.cssText = `
            position:absolute;top:50%;left:50%;
            transform:translate(-50%,-50%) rotate(-45deg);
            font-size:200px;font-weight:900;
            color:rgba(255,255,255,0.08);
            white-space:nowrap;pointer-events:none;
            z-index:2;user-select:none;
            text-transform:uppercase;letter-spacing:40px;
            text-shadow:0 0 60px rgba(0,0,0,0.8);`;
        return el;
    }

    // ── Fullscreen GIF background ──────────────────────────────
    function createGifBackground() {
        const bg = document.createElement('div');
        bg.style.cssText = `
            position:absolute;top:0;left:0;width:100%;height:100%;
            background-image:url('${CONFIG.bgGif}');
            background-size:cover;
            background-position:center center;
            background-repeat:no-repeat;
            pointer-events:none;
            z-index:0;`;
        return bg;
    }

    // ── Dark overlay so content stays readable ─────────────────
    function createOverlay() {
        const ov = document.createElement('div');
        ov.style.cssText = `
            position:absolute;top:0;left:0;width:100%;height:100%;
            background:rgba(0,0,0,0.55);
            pointer-events:none;
            z-index:1;`;
        return ov;
    }

    // ── Modal base ─────────────────────────────────────────────
    function createModalBase(zIndex=10000) {
        const modal = document.createElement('div');
        modal.style.cssText = `
            position:fixed;top:0;left:0;width:100%;height:100%;
            z-index:${zIndex};
            display:flex;justify-content:center;align-items:center;
            animation:fadeIn 0.3s ease;
            overflow:hidden;`;
        modal.appendChild(createGifBackground());
        modal.appendChild(createOverlay());
        modal.appendChild(createWatermark());
        return modal;
    }

    // ── Floating button ────────────────────────────────────────
    function createViewButton() {
        const button = document.createElement('button');
        button.id = 'countryReportsBtn';
        button.textContent = CONFIG.buttonText;
        button.style.cssText = `position:fixed;top:80px;right:-250px;z-index:9999;padding:12px 24px;background-color:${CONFIG.buttonColor};color:white;border:none;border-radius:6px;font-size:14px;font-weight:bold;cursor:pointer;box-shadow:0 4px 6px rgba(0,0,0,0.1);transition:all 0.3s ease;`;
        button.onmouseover = () => { button.style.backgroundColor='#f57c00'; button.style.transform='scale(1.05)'; };
        button.onmouseout  = () => { button.style.backgroundColor=CONFIG.buttonColor; button.style.transform='scale(1)'; };
        button.onclick = showDatePickerModal;
        document.body.appendChild(button);

        const hoverZone = document.createElement('div');
        hoverZone.style.cssText = `position:fixed;top:60px;right:0;width:200px;height:100px;z-index:9998;pointer-events:all;`;
        hoverZone.onmouseenter = () => { button.style.right='20px'; };
        hoverZone.onmouseleave = () => { setTimeout(()=>{ if(!button.matches(':hover')) button.style.right='-250px'; },100); };
        button.onmouseleave = () => { setTimeout(()=>{ if(!hoverZone.matches(':hover')) button.style.right='-250px'; },100); };
        document.body.appendChild(hoverZone);
    }

    // ── Date picker ────────────────────────────────────────────
    function showDatePickerModal() {
        const modal = createModalBase(10000);
        modal.id = 'datePickerModal';
        const today = new Date().toISOString().split('T')[0];

        const content = document.createElement('div');
        content.style.cssText = `position:relative;z-index:3;background:linear-gradient(135deg,rgba(26,26,26,0.97) 0%,rgba(45,45,45,0.97) 100%);color:#fff;padding:40px;border-radius:12px;box-shadow:0 10px 50px rgba(0,0,0,0.7);border:2px solid #ff9800;min-width:400px;backdrop-filter:blur(4px);`;
        content.innerHTML = `
            <h2 style="margin:0 0 20px 0;color:#ff9800;text-align:center;">🎯 Select Date Range</h2>
            <div style="margin-bottom:20px;">
                <label style="display:block;margin-bottom:8px;color:#aaa;">From Date:</label>
                <input type="date" id="dateFrom" value="${today}" style="width:100%;padding:10px;border-radius:6px;border:1px solid #555;background:#333;color:white;font-size:14px;">
            </div>
            <div style="margin-bottom:30px;">
                <label style="display:block;margin-bottom:8px;color:#aaa;">To Date:</label>
                <input type="date" id="dateTo" value="${today}" style="width:100%;padding:10px;border-radius:6px;border:1px solid #555;background:#333;color:white;font-size:14px;">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:20px;">
                <button id="todayBtn"     style="padding:10px;background:#2196F3;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">Today</button>
                <button id="yesterdayBtn" style="padding:10px;background:#2196F3;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">Yesterday</button>
                <button id="last7daysBtn" style="padding:10px;background:#2196F3;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">Last 7 Days</button>
            </div>
            <div style="display:flex;gap:10px;">
                <button id="nextBtn"   style="flex:1;padding:14px;background:linear-gradient(135deg,#ff9800,#f57c00);color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:16px;">🎯 Select Campaigns →</button>
                <button id="cancelBtn" style="padding:14px 20px;background:#f44336;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">Cancel</button>
            </div>`;

        modal.appendChild(content); document.body.appendChild(modal);

        document.getElementById('todayBtn').onclick = () => { const d=new Date().toISOString().split('T')[0]; document.getElementById('dateFrom').value=d; document.getElementById('dateTo').value=d; };
        document.getElementById('yesterdayBtn').onclick = () => { const y=new Date(); y.setDate(y.getDate()-1); const d=y.toISOString().split('T')[0]; document.getElementById('dateFrom').value=d; document.getElementById('dateTo').value=d; };
        document.getElementById('last7daysBtn').onclick = () => { const to=new Date(),from=new Date(); from.setDate(from.getDate()-7); document.getElementById('dateFrom').value=from.toISOString().split('T')[0]; document.getElementById('dateTo').value=to.toISOString().split('T')[0]; };
        document.getElementById('nextBtn').onclick = () => {
            currentDateRange = { from: document.getElementById('dateFrom').value, to: document.getElementById('dateTo').value };
            cachedCampaignResults = null; modal.remove(); showCampaignsModal();
        };
        document.getElementById('cancelBtn').onclick = () => modal.remove();
        modal.onclick = (e) => { if(e.target===modal) modal.remove(); };
    }

    // ── Fetch one campaign ─────────────────────────────────────
    function fetchCampaignConversions(offerId) {
        return new Promise((resolve, reject) => {
            const url = `https://galaxywebrevenue2.com/report/offer/${offerId}/conversions-by-country?filter=country&d_from=${currentDateRange.from}&d_to=${currentDateRange.to}&dateSelect=0`;
            GM_xmlhttpRequest({
                method: 'GET', url,
                onload(response) {
                    if(response.status===200) {
                        const doc = new DOMParser().parseFromString(response.responseText,'text/html');
                        const titleEl = doc.querySelector('h1,.page-title,title');
                        const campaignName = titleEl ? titleEl.textContent.trim() : `Campaign ${offerId}`;
                        resolve({ offerId, campaignName, data: parseCountryData(doc) });
                    } else reject(new Error(`Failed ${offerId}`));
                },
                onerror() { reject(new Error(`Network error ${offerId}`)); }
            });
        });
    }

    // ── Campaign selector modal ────────────────────────────────
    function showCampaignsModal() {
        const modal = createModalBase(10001);
        modal.id = 'campaignsModal';

        const content = document.createElement('div');
        content.style.cssText = `position:relative;z-index:3;background:linear-gradient(135deg,rgba(26,26,26,0.97) 0%,rgba(45,45,45,0.97) 100%);color:#fff;padding:40px;border-radius:12px;box-shadow:0 10px 50px rgba(0,0,0,0.7);border:2px solid #ff9800;min-width:500px;max-width:90%;max-height:90vh;overflow-y:auto;backdrop-filter:blur(4px);`;
        content.innerHTML = `
            <h2 style="margin:0 0 5px 0;color:#ff9800;text-align:center;">🎯 Select Campaigns to View</h2>
            <p style="color:#aaa;text-align:center;margin:0 0 20px 0;font-size:13px;">Date range: ${currentDateRange.from} → ${currentDateRange.to}</p>
            <div id="campaignSelectionArea">
                <input type="text" id="campaignSearch" placeholder="Search campaigns..." style="width:100%;padding:10px;border-radius:6px;border:1px solid #555;background:#333;color:white;font-size:14px;margin-bottom:10px;box-sizing:border-box;">
                <div style="display:flex;gap:10px;margin-bottom:12px;">
                    <button id="selectAllCampaigns"   style="flex:1;padding:8px;background:#2196F3;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:12px;">Select All</button>
                    <button id="deselectAllCampaigns" style="flex:1;padding:8px;background:#666;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:12px;">Deselect All</button>
                </div>
                <div id="campaignsList" style="max-height:380px;overflow-y:auto;margin-bottom:15px;border:1px solid #444;border-radius:6px;padding:10px;background:#0a0a0a;"></div>
                <div id="campaignLoadingIndicator" style="display:none;margin:20px 0;text-align:center;color:#ff9800;">
                    <div style="display:inline-block;width:20px;height:20px;border:3px solid #ff9800;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;"></div>
                    <p style="margin-top:10px;">Loading campaigns data...</p>
                    <p id="campaignProgress" style="margin-top:5px;font-size:12px;color:#aaa;"></p>
                </div>
                <div style="display:flex;gap:10px;">
                    <button id="backToDateBtn"       style="padding:14px 20px;background:#9C27B0;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">← Back</button>
                    <button id="fetchCampaignsBtn"   style="flex:1;padding:14px;background:linear-gradient(135deg,#ff9800,#f57c00);color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:16px;">📊 Fetch Selected Campaigns</button>
                    <button id="closeCampaignsModal" style="padding:14px 20px;background:#f44336;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;">Close</button>
                </div>
            </div>
            <div id="campaignResults" style="display:none;"></div>`;

        modal.appendChild(content); document.body.appendChild(modal);

        const list = document.getElementById('campaignsList');
        campaigns.forEach(c => {
            const div = document.createElement('div');
            div.className = 'campaign-item';
            div.style.cssText = `padding:10px;margin-bottom:8px;background:#1a1a1a;border-radius:6px;border:1px solid #333;transition:all 0.2s;`;
            div.innerHTML = `<label style="display:flex;align-items:center;cursor:pointer;user-select:none;">
                <input type="checkbox" class="campaign-checkbox" data-id="${c.id}" style="margin-right:10px;width:18px;height:18px;cursor:pointer;">
                <span style="color:#ff9800;font-weight:bold;margin-right:8px;">${c.id}</span>
                <span style="color:#ddd;flex:1;">${c.name}</span>
            </label>`;
            div.onmouseover = () => { div.style.background='#252525'; div.style.borderColor='#ff9800'; };
            div.onmouseout  = () => { div.style.background='#1a1a1a'; div.style.borderColor='#333'; };
            list.appendChild(div);
        });

        document.getElementById('campaignSearch').oninput = (e) => {
            const t = e.target.value.toLowerCase();
            document.querySelectorAll('.campaign-item').forEach(item => { item.style.display = item.textContent.toLowerCase().includes(t)?'block':'none'; });
        };
        document.getElementById('selectAllCampaigns').onclick   = () => { document.querySelectorAll('.campaign-checkbox').forEach(cb => { if(cb.closest('.campaign-item').style.display!=='none') cb.checked=true; }); };
        document.getElementById('deselectAllCampaigns').onclick = () => { document.querySelectorAll('.campaign-checkbox').forEach(cb => cb.checked=false); };
        document.getElementById('backToDateBtn').onclick        = () => { modal.remove(); showDatePickerModal(); };
        document.getElementById('closeCampaignsModal').onclick  = () => modal.remove();

        document.getElementById('fetchCampaignsBtn').onclick = async () => {
            const selectedIds = Array.from(document.querySelectorAll('.campaign-checkbox:checked')).map(cb => cb.dataset.id);
            if(selectedIds.length===0) { alert('Please select at least one campaign'); return; }

            const loadingIndicator = document.getElementById('campaignLoadingIndicator');
            const progressText     = document.getElementById('campaignProgress');
            const selectionArea    = document.getElementById('campaignSelectionArea');
            loadingIndicator.style.display = 'block';
            selectionArea.querySelectorAll('button,input').forEach(el => el.disabled=true);

            // ── Parallel fetch with concurrency limit of 5 ──────────
            const CONCURRENCY = 5;
            let completed = 0;
            const results = [];

            async function fetchWithProgress(id) {
                try {
                    const result = await fetchCampaignConversions(id);
                    results.push(result);
                } catch(err) {
                    console.error(`Error fetching campaign ${id}:`, err);
                } finally {
                    completed++;
                    progressText.textContent = `Loaded ${completed} of ${selectedIds.length}... (${selectedIds.length - completed} remaining)`;
                }
            }

            // Run in batches of CONCURRENCY
            for(let i = 0; i < selectedIds.length; i += CONCURRENCY) {
                const batch = selectedIds.slice(i, i + CONCURRENCY).map(id => fetchWithProgress(id));
                await Promise.all(batch);
            }

            loadingIndicator.style.display = 'none';
            selectionArea.style.display    = 'none';
            cachedCampaignResults = results;
            displayCampaignResults(results, modal);
        };

        modal.onclick = (e) => { if(e.target===modal) modal.remove(); };
    }

    // ── Aggregate country totals across all campaigns ──────────
    function buildCountryTotals(results) {
        const map = {};
        results.forEach(campaign => {
            campaign.data.forEach(row => {
                const country = row['Country'] || 'Unknown';
                if(!map[country]) map[country] = { country, conversions:0, clicks:0, uniqueClicks:0 };
                map[country].conversions  += parseInt(row['Conversions'])   || 0;
                map[country].clicks       += parseInt(row['Clicks'])        || 0;
                map[country].uniqueClicks += parseInt(row['Unique Clicks']) || 0;
            });
        });
        return Object.values(map).sort((a,b) => b.conversions - a.conversions);
    }

    // ── Campaign results + grand summary ──────────────────────
    function displayCampaignResults(results, parentModal) {
        const resultsDiv = document.getElementById('campaignResults');
        resultsDiv.style.cssText = 'display:block;position:relative;z-index:3;';

        const withConversions  = results.filter(c => c.data.reduce((s,r)=>s+(parseInt(r['Conversions'])||0),0) > 0);
        const grandTotal       = results.reduce((s,c) => s+c.data.reduce((ss,r)=>ss+(parseInt(r['Conversions'])||0),0), 0);
        const grandClicks      = results.reduce((s,c) => s+c.data.reduce((ss,r)=>ss+(parseInt(r['Clicks'])||0),0), 0);
        const countryTotals    = buildCountryTotals(withConversions);
        const grandCountryConv = countryTotals.reduce((s,r) => s+r.conversions, 0);
        const grandCountryClk  = countryTotals.reduce((s,r) => s+r.clicks, 0);
        const grandCountryUQ   = countryTotals.reduce((s,r) => s+r.uniqueClicks, 0);

        let countryRows = '';
        countryTotals.forEach((row, idx) => {
            const bg       = idx%2===0 ? '#1a1a1a' : '#252525';
            const share    = grandCountryConv > 0 ? ((row.conversions/grandCountryConv)*100).toFixed(1) : '0.0';
            const barWidth = grandCountryConv > 0 ? Math.round((row.conversions/grandCountryConv)*100) : 0;
            countryRows += `
                <tr style="background:${bg};" onmouseover="this.style.background='#333'" onmouseout="this.style.background='${bg}'">
                    <td style="padding:9px 12px;border-bottom:1px solid #333;color:#aaa;">${idx+1}</td>
                    <td style="padding:9px 12px;border-bottom:1px solid #333;font-weight:bold;">
                        ${row.country}
                        <div style="margin-top:4px;height:4px;background:#333;border-radius:2px;width:120px;">
                            <div style="height:4px;background:#ff9800;border-radius:2px;width:${barWidth}%;"></div>
                        </div>
                    </td>
                    <td style="padding:9px 12px;border-bottom:1px solid #333;text-align:right;color:#4CAF50;font-weight:bold;font-size:14px;">${row.conversions}</td>
                    <td style="padding:9px 12px;border-bottom:1px solid #333;text-align:right;color:#aaa;">${share}%</td>
                    <td style="padding:9px 12px;border-bottom:1px solid #333;text-align:right;color:#2196F3;">${row.clicks}</td>
                    <td style="padding:9px 12px;border-bottom:1px solid #333;text-align:right;color:#FF9800;">${row.uniqueClicks}</td>
                </tr>`;
        });

        let campaignCards = '';
        if(withConversions.length===0) {
            campaignCards = '<p style="color:#aaa;text-align:center;padding:20px;">No campaigns with conversions found for the selected date range.</p>';
        } else {
            withConversions.forEach(campaign => {
                const totalConv = campaign.data.reduce((s,r)=>s+(parseInt(r['Conversions'])||0),0);
                const totalClk  = campaign.data.reduce((s,r)=>s+(parseInt(r['Clicks'])||0),0);
                campaignCards += `
                    <div style="background:#0a0a0a;padding:15px;margin-bottom:12px;border-radius:6px;border:1px solid #444;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
                            <div>
                                <span style="color:#ff9800;font-weight:bold;font-size:16px;">${campaign.offerId}</span>
                                <span style="color:#ddd;margin-left:10px;">${campaign.campaignName}</span>
                            </div>
                            <div>
                                <span style="color:#4CAF50;font-weight:bold;margin-right:15px;">${totalConv} Conversions</span>
                                <span style="color:#2196F3;">${totalClk} Clicks</span>
                            </div>
                        </div>
                        <button class="viewCampaignDetails" data-campaign='${JSON.stringify(campaign).replace(/'/g,"&#39;")}' style="padding:8px 16px;background:#2196F3;color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:12px;">View Details</button>
                    </div>`;
            });
        }

        resultsDiv.innerHTML = `
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:24px;">
                <div style="background:linear-gradient(135deg,#1b5e20,#2e7d32);padding:16px;border-radius:8px;text-align:center;border:1px solid #4CAF50;">
                    <div style="font-size:30px;font-weight:900;color:#fff;">${grandTotal}</div>
                    <div style="color:#a5d6a7;font-size:11px;margin-top:4px;letter-spacing:1px;">TOTAL CONVERSIONS</div>
                </div>
                <div style="background:linear-gradient(135deg,#0d47a1,#1565c0);padding:16px;border-radius:8px;text-align:center;border:1px solid #2196F3;">
                    <div style="font-size:30px;font-weight:900;color:#fff;">${grandClicks}</div>
                    <div style="color:#90caf9;font-size:11px;margin-top:4px;letter-spacing:1px;">TOTAL CLICKS</div>
                </div>
                <div style="background:linear-gradient(135deg,#bf360c,#d84315);padding:16px;border-radius:8px;text-align:center;border:1px solid #ff9800;">
                    <div style="font-size:30px;font-weight:900;color:#fff;">${withConversions.length}</div>
                    <div style="color:#ffcc80;font-size:11px;margin-top:4px;letter-spacing:1px;">ACTIVE CAMPAIGNS</div>
                </div>
                <div style="background:linear-gradient(135deg,#4a148c,#6a1b9a);padding:16px;border-radius:8px;text-align:center;border:1px solid #9C27B0;">
                    <div style="font-size:30px;font-weight:900;color:#fff;">${countryTotals.length}</div>
                    <div style="color:#ce93d8;font-size:11px;margin-top:4px;letter-spacing:1px;">COUNTRIES</div>
                </div>
            </div>

            <div style="background:#0a0a0a;border-radius:8px;padding:15px;border:1px solid #444;margin-bottom:24px;">
                <h3 style="color:#ff9800;margin:0 0 14px 0;font-size:16px;">🌍 Total Conversions by Country</h3>
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="background:#2a2a2a;">
                                <th style="padding:10px 12px;text-align:left;border-bottom:2px solid #ff9800;color:#ff9800;">#</th>
