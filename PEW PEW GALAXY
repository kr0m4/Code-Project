    // ── Cached results modal (back from detail view) ───────────
    function showCampaignsModalWithResults() {
        const modal = createModalBase(10001);
        modal.id = 'campaignsModal';
        const content = document.createElement('div');
        content.style.cssText = `position:relative;z-index:3;background:linear-gradient(135deg,rgba(26,26,26,0.97) 0%,rgba(45,45,45,0.97) 100%);color:#fff;padding:40px;border-radius:12px;box-shadow:0 10px 50px rgba(0,0,0,0.7);border:2px solid #ff9800;min-width:500px;max-width:90%;max-height:90vh;overflow-y:auto;backdrop-filter:blur(4px);`;
        content.innerHTML = `<h2 style="margin:0 0 20px 0;color:#ff9800;text-align:center;">🎯 Campaign Results</h2><div id="campaignSelectionArea" style="display:none;"></div><div id="campaignResults" style="display:block;"></div>`;
        modal.appendChild(content); document.body.appendChild(modal);
        displayCampaignResults(cachedCampaignResults, modal);
        modal.onclick = (e) => { if(e.target===modal) modal.remove(); };
    }

    // ── Parse country table from HTML doc ─────────────────────
    function parseCountryData(doc) {
        const data = []; const seen = new Set();
        doc.querySelectorAll('table').forEach(table => {
            const headerRow = table.querySelector('tr');
            if(!headerRow) return;
            const headers = Array.from(headerRow.querySelectorAll('th,td')).map(th=>th.textContent.trim()).filter(h=>h);
            if(headers.includes('Country') || headers.includes('Clicks')) {
                Array.from(table.querySelectorAll('tr')).slice(1).forEach(row => {
                    const cells = Array.from(row.querySelectorAll('td,th'));
                    if(cells.length>=2) {
                        const rowData = {};
                        cells.forEach((cell,i) => { if(headers[i]) rowData[headers[i]] = cell.textContent.trim(); });
                        const hasData = Object.values(rowData).some(v => v && v!=='' && v!=='-');
                        const country = rowData['Country'];
                        if(hasData && country && !seen.has(country) && country.toLowerCase()!=='total') {
                            seen.add(country); data.push(rowData);
                        }
                    }
                });
            }
        });
        return data;
    }

    // ── Per-campaign country detail modal ──────────────────────
    function displayResults(data, reportTitle) {
        document.getElementById('reportsDataModal')?.remove();
        const modal = createModalBase(10000);
        modal.id = 'reportsDataModal';

        const content = document.createElement('div');
        content.style.cssText = `position:relative;z-index:3;background:linear-gradient(135deg,rgba(26,26,26,0.97) 0%,rgba(45,45,45,0.97) 100%);color:#fff;padding:30px;border-radius:12px;max-width:95%;max-height:90vh;overflow-y:auto;box-shadow:0 10px 50px rgba(0,0,0,0.7);border:2px solid #ff9800;backdrop-filter:blur(4px);`;

        const headers = Object.keys(data[0]);
        let totalConv=0, totalClk=0, totalUQ=0;
        data.forEach(r => { totalConv+=parseInt(r['Conversions'])||0; totalClk+=parseInt(r['Clicks'])||0; totalUQ+=parseInt(r['Unique Clicks'])||0; });

        let rows = '';
        data.forEach((row,idx) => {
            const bg = idx%2===0?'#1a1a1a':'#252525';
            rows += `<tr style="background:${bg};transition:background 0.2s;" onmouseover="this.style.backgroundColor='#333'" onmouseout="this.style.backgroundColor='${bg}'">`;
            headers.forEach(h => {
                const val = row[h]||'-';
                const hi  = h==='Conversions' && parseInt(val)>=5 ? 'color:#4CAF50;font-weight:bold;' : '';
                rows += `<td style="padding:12px;border-bottom:1px solid #333;white-space:nowrap;${hi}">${val}</td>`;
            });
            rows += `</tr>`;
        });

        let ths = '';
        headers.forEach(h => { ths += `<th style="padding:14px 12px;text-align:left;border-bottom:2px solid #ff9800;white-space:nowrap;color:#ff9800;font-weight:bold;">${h}</th>`; });

        content.innerHTML = `
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
                <div>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span style="font-size:32px;">🎯</span>
                        <h2 style="margin:0;color:#ff9800;">${reportTitle}</h2>
                    </div>
                    <p style="margin:5px 0 0 0;color:#aaa;font-size:13px;">
                        ${data.length} countries |
                        <span style="color:#4CAF50;font-weight:bold;">${totalConv}</span> Conversions |
                        <span style="color:#2196F3;">${totalClk}</span> Clicks |
                        <span style="color:#FF9800;">${totalUQ}</span> Unique
                    </p>
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                    <button id="backToCampaignsBtn" style="background:#9C27B0;color:white;border:none;padding:10px 20px;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px;">🔙 Back</button>
                    <button id="closeModal" style="background:#f44336;color:white;border:none;padding:10px 20px;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px;">✕ Close</button>
                </div>
            </div>
            <div style="overflow-x:auto;background:#0a0a0a;border-radius:8px;padding:10px;">
                <table style="width:100%;border-collapse:collapse;margin:10px 0;font-size:13px;">
                    <thead><tr style="background:#2a2a2a;position:sticky;top:0;">${ths}</tr></thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:20px;">
                <button id="downloadCSV"   style="padding:14px;background:linear-gradient(135deg,#4CAF50,#45a049);color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px;">⬇️ CSV</button>
                <button id="downloadJSON"  style="padding:14px;background:linear-gradient(135deg,#2196F3,#1976D2);color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px;">⬇️ JSON</button>
                <button id="downloadExcel" style="padding:14px;background:linear-gradient(135deg,#10793f,#0d5c2f);color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px;">📊 Excel</button>
                <button id="copyData"      style="padding:14px;background:linear-gradient(135deg,#FF9800,#F57C00);color:white;border:none;border-radius:6px;cursor:pointer;font-weight:bold;font-size:14px;">📋 Copy</button>
            </div>`;

        modal.appendChild(content); document.body.appendChild(modal);

        document.getElementById('downloadCSV').onclick   = () => downloadCSV(data, reportTitle);
        document.getElementById('downloadJSON').onclick  = () => downloadJSON(data);
        document.getElementById('downloadExcel').onclick = () => downloadExcel(data, reportTitle);
        document.getElementById('copyData').onclick      = () => copyToClipboard(data);
        document.getElementById('closeModal').onclick    = () => modal.remove();
        document.getElementById('backToCampaignsBtn').onclick = () => { modal.remove(); if(cachedCampaignResults) showCampaignsModalWithResults(); };
        modal.onclick = (e) => { if(e.target===modal) modal.remove(); };
        document.addEventListener('keydown', function esc(e) { if(e.key==='Escape') { modal.remove(); document.removeEventListener('keydown',esc); } });
    }

    // ── Download helpers ───────────────────────────────────────
    function downloadCSV(data, reportTitle) {
        const headers = Object.keys(data[0]);
        let csv = headers.join(',') + '\n';
        data.forEach(row => { csv += headers.map(h => { const v=(row[h]||'').toString(); return v.includes(',')?`"${v.replace(/"/g,'""')}"`:`${v}`; }).join(',') + '\n'; });
        downloadFile(csv, `campaign_conversions_${new Date().toISOString().slice(0,10)}.csv`, 'text/csv');
        showNotification('✅ CSV downloaded!');
    }
    function downloadJSON(data) {
        downloadFile(JSON.stringify(data,null,2), `campaign_conversions_${new Date().toISOString().slice(0,10)}.json`, 'application/json');
        showNotification('✅ JSON downloaded!');
    }
    function downloadExcel(data, reportTitle) {
        const headers = Object.keys(data[0]);
        let xls = `<html><head><meta charset="UTF-8"><style>table{border-collapse:collapse;font-family:Arial;}th{background:#ff9800;color:white;font-weight:bold;padding:8px;border:1px solid #ddd;}td{padding:8px;border:1px solid #ddd;}tr:nth-child(even){background:#f2f2f2;}</style></head><body><h2>${reportTitle}</h2><table><thead><tr>`;
        headers.forEach(h => xls += `<th>${h}</th>`);
        xls += `</tr></thead><tbody>`;
        data.forEach(row => { xls += '<tr>'; headers.forEach(h => xls += `<td>${row[h]||''}</td>`); xls += '</tr>'; });
        xls += `</tbody></table></body></html>`;
        downloadFile(xls, `campaign_conversions_${new Date().toISOString().slice(0,10)}.xls`, 'application/vnd.ms-excel');
        showNotification('✅ Excel downloaded!');
    }
    function copyToClipboard(data) {
        const headers = Object.keys(data[0]);
        let text = headers.join('\t') + '\n';
        data.forEach(row => { text += headers.map(h => row[h]||'').join('\t') + '\n'; });
        navigator.clipboard.writeText(text).then(() => showNotification('✅ Copied to clipboard!'));
    }
    function downloadFile(content, filename, type) {
        const blob = new Blob([content],{type});
        const url  = URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href=url; a.download=filename;
        document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
    }
    function showNotification(msg) {
        const n = document.createElement('div');
        n.textContent = msg;
        n.style.cssText = `position:fixed;top:80px;right:20px;background:linear-gradient(135deg,#ff9800,#f57c00);color:white;padding:16px 28px;border-radius:8px;z-index:10001;box-shadow:0 6px 20px rgba(255,152,0,0.4);animation:slideIn 0.3s ease;font-weight:bold;border:2px solid rgba(255,255,255,0.3);`;
        document.body.appendChild(n);
        setTimeout(() => { n.style.animation='slideOut 0.3s ease'; setTimeout(()=>n.remove(),300); }, 3000);
    }

    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn  { from { transform:translateX(400px); opacity:0; } to { transform:translateX(0);    opacity:1; } }
        @keyframes slideOut { from { transform:translateX(0);    opacity:1; } to { transform:translateX(400px); opacity:0; } }
        @keyframes fadeIn   { from { opacity:0; } to { opacity:1; } }
        @keyframes spin     { to   { transform:rotate(360deg); } }
    `;
    document.head.appendChild(style);

    if(document.readyState==='loading') { document.addEventListener('DOMContentLoaded', createViewButton); } else { createViewButton(); }
})();
