            <ellipse cx="30" cy="28" rx="1.5" ry="2" fill="#000"/>
            <path d="M 25 30 Q 30 32 35 30" stroke="#000" fill="none" stroke-width="1"/>
            <ellipse cx="15" cy="40" rx="3" ry="2" fill="#ff6f00"/>
            <ellipse cx="45" cy="40" rx="3" ry="2" fill="#ff6f00"/>
        `;

        let eggplantX = Math.random() * (window.innerWidth - 50);
        let eggplantY = Math.random() * (window.innerHeight - 50);
        let catX = eggplantX - 80;
        let catY = eggplantY;

        let eggplantSpeedX = (Math.random() - 0.5) * 4 + 3;
        let eggplantSpeedY = (Math.random() - 0.5) * 4;

        function animate() {
            eggplantX += eggplantSpeedX;
            eggplantY += eggplantSpeedY;

            if (eggplantX <= 0 || eggplantX >= window.innerWidth - 50) {
                eggplantSpeedX = -eggplantSpeedX + (Math.random() - 0.5) * 2;
                eggplantSpeedY += (Math.random() - 0.5) * 2;
            }
            if (eggplantY <= 0 || eggplantY >= window.innerHeight - 50) {
                eggplantSpeedY = -eggplantSpeedY + (Math.random() - 0.5) * 2;
                eggplantSpeedX += (Math.random() - 0.5) * 2;
            }

            eggplantSpeedX = Math.max(-5, Math.min(5, eggplantSpeedX));
            eggplantSpeedY = Math.max(-5, Math.min(5, eggplantSpeedY));

            const dx = eggplantX - catX;
            const dy = eggplantY - catY;
            const distance = Math.sqrt(dx * dx + dy * dy);

            const catSpeedX = distance > 100 ? (dx / distance) * 4 : (dx / distance) * 2;
            const catSpeedY = distance > 100 ? (dy / distance) * 4 : (dy / distance) * 2;

            catX += catSpeedX;
            catY += catSpeedY;

            if (distance < 30 || Math.random() < 0.002) {
                eggplantX = Math.random() * (window.innerWidth - 50);
                eggplantY = Math.random() * (window.innerHeight - 50);
                catX = eggplantX - 100;
                catY = eggplantY;
                eggplantSpeedX = (Math.random() - 0.5) * 4 + 3;
                eggplantSpeedY = (Math.random() - 0.5) * 4;
            }

            eggplant.style.left = eggplantX + 'px';
            eggplant.style.top = eggplantY + 'px';
            cat.style.left = catX + 'px';
            cat.style.top = catY + 'px';

            eggplant.style.transform = eggplantSpeedX < 0 ? 'scaleX(-1)' : 'scaleX(1)';
            cat.style.transform = catSpeedX < 0 ? 'scaleX(-1)' : 'scaleX(1)';

            requestAnimationFrame(animate);
        }

        container.appendChild(eggplant);
        container.appendChild(cat);
        animate();

        return container;
    }

