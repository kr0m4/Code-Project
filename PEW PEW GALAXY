        { id: '1013', name: 'JLG - UNIVERSAL - NO CAP - AU/US/NZ/IE/CA/FR/IT' },
        { id: '1025', name: 'NC - NO CAP - AU/GB/US/IE/FR/IT/ES' },
        { id: '1026', name: 'NC - XHP - NO CAP - DE/NL/BE/AT' },
        { id: '1027', name: 'NC - XXHP - NO CAP - CH/SE/NO/DK/FI' },
        { id: '1028', name: 'CC - NO CAP - AU/GB/US/IE/FR/IT/ES' },
        { id: '1029', name: 'CC - XHP - NO CAP - DE/NL/BE/AT' },
        { id: '1030', name: 'CC - XXHP - NO CAP - CH/SE/NO/DK/FI' },
        { id: '1031', name: 'WD - NO CAP - AU/GB/US/IE/FR/IT/ES' },
        { id: '1032', name: 'WD - XHP - NO CAP - DE/NL/BE/AT' },
        { id: '1033', name: 'WD - XXHP - NO CAP - CH/SE/NO/DK/FI' },
        { id: '1034', name: 'CV - NO CAP - AU/GB/US/IE/FR/IT/ES' },
        { id: '1035', name: 'CV - XHP - NO CAP - DE/NL/BE/AT' },
        { id: '1036', name: 'CV - XXHP - NO CAP - CH/SE/NO/DK/FI' },
