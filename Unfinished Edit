            console.log('\n📋 Debugging info:');
            console.log('All links on page:');
            document.querySelectorAll('a').forEach((a, i) => {
                if (i < 20) { // Only show first 20
                    console.log(`  ${i}: "${a.textContent.trim().substring(0, 50)}" - ${a.href}`);
