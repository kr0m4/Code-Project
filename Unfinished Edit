    console.log('\n🏁 Initializing script...');
    console.log(`   Current URL: ${window.location.href}`);
    console.log(`   Pathname: ${window.location.pathname}`);

    setTimeout(() => {
        if (window.location.pathname.startsWith('/logger/')) {
            console.log('📍 On logger detail page');

            // Check if we're in edit mode
            const state = JSON.parse(sessionStorage.getItem('batch_state') || 'null');
            const editNewUrl = sessionStorage.getItem('edit_new_url');

            console.log('Edit mode check:');
            console.log('  - State exists:', !!state);
            console.log('  - State running:', state?.running);
            console.log('  - State mode:', state?.mode);
            console.log('  - Edit new URL:', editNewUrl);

            if (state && state.running && state.mode === 'edit' && editNewUrl) {
                console.log('🔧 Edit mode active, handling edit on this page...');
                console.log(`🎯 Target new URL: ${editNewUrl}`);

                // Wait a bit longer for page to fully load
                setTimeout(() => {
                    handleLoggerPageEdit().then(success => {
                        if (success) {
                            console.log('✅ Edit completed successfully!');
                        } else {
                            console.log('❌ Edit failed!');
                        }

                        console.log('🔄 Returning to account page in 1 second...');
                        setTimeout(() => {
                            window.location.href = 'https://iplogger.org/account/';
                        }, 1000);
                    }).catch(error => {
                        console.error('❌ Error during edit:', error);
                        setTimeout(() => {
                            window.location.href = 'https://iplogger.org/account/';
                        }, 1000);
                    });
                }, 1500); // Wait 1.5 seconds for page to fully load
            } else {
                console.log('📍 Not in edit mode, returning to account...');
                setTimeout(() => {
                    window.location.href = 'https://iplogger.org/account/';
                }, 50);
            }
            return;
        }

        if (window.location.pathname.startsWith('/account')) {
            console.log('📍 On account page');
            createControlPanel();
            checkAndContinueBatch();
        }
    }, 50);

