        const currentValue = urlInput.value;
        console.log(`✓ Found input with current value: "${currentValue}"`);
        console.log(`🔄 Changing to: "${newUrl}"`);

        // Clear and update the input
        urlInput.value = '';
        urlInput.focus();
        await new Promise(r => setTimeout(r, 100));

        urlInput.value = newUrl;

        // Fire all events
        ['input', 'change', 'keyup', 'blur'].forEach(eventType => {
            urlInput.dispatchEvent(new Event(eventType, { bubbles: true }));
        });

        await new Promise(r => setTimeout(r, 300));
        console.log(`✓ Input updated. New value: "${urlInput.value}"`);

