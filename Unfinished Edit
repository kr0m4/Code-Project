    // Get all existing links from the page
    function getExistingLinks() {
        const links = [];

        console.log('🔍 SEARCHING FOR EXISTING LINKS...');
        console.log('═══════════════════════════════════════');

        // Find all links that contain 2no.co with "Open link" text (these are the shortened links)
        const allLinks = document.querySelectorAll('a');
        const shortLinks = Array.from(allLinks).filter(a =>
            a.href && a.href.includes('2no.co') && a.textContent.trim() === 'Open link'
        );

        console.log(`Found ${shortLinks.length} shortened links with "Open link" text`);

        shortLinks.forEach((shortLink, index) => {
            const slug = shortLink.href.split('/').pop();
            console.log(`\n📋 Processing link ${index + 1}: ${slug}`);

            // Find the parent container of this link
            let container = shortLink.parentElement;
            let loggerLink = null;

            // Search up to 10 levels of parents to find the row/card container
            for (let i = 0; i < 10; i++) {
                if (!container) break;

                console.log(`  Checking parent level ${i + 1}: ${container.tagName}.${container.className}`);

                // Look for any link in this container that goes to /logger/
                const linksInContainer = container.querySelectorAll('a');

                linksInContainer.forEach(link => {
                    if (link.href.includes('/logger/') && link !== shortLink) {
                        loggerLink = link;
                        console.log(`  ✓ Found logger link: ${link.href}`);
                    }
                });

                if (loggerLink) break;

                container = container.parentElement;
            }

            if (loggerLink) {
                links.push({
                    slug: slug,
                    loggerUrl: loggerLink.href,
                    fullUrl: shortLink.href,
                    rowIndex: index
                });
                console.log(`  ✅ Added: ${slug} -> ${loggerLink.href}`);
            } else {
                console.log(`  ❌ Could not find logger link for ${slug}`);

                // Try alternative method: look for the chart/stats icon near this link
                const parent = shortLink.closest('tr, div[class*="row"], div[class*="item"], div[class*="card"], div[class*="link"], li, article');
                if (parent) {
                    console.log(`  📦 Found closest container: ${parent.tagName}.${parent.className}`);
                    const allContainerLinks = parent.querySelectorAll('a');
                    console.log(`  Found ${allContainerLinks.length} links in container:`);
                    allContainerLinks.forEach((l, i) => {
                        console.log(`    ${i}: ${l.href} | text: "${l.textContent.trim().substring(0, 30)}"`);
                    });
                }
            }
        });

        console.log('═══════════════════════════════════════');
        console.log(`✅ TOTAL LINKS FOUND: ${links.length}`);
        console.log('═══════════════════════════════════════\n');

        return links;
    }

