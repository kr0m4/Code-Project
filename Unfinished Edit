    // Check if we should continue batch
    function checkAndContinueBatch() {
        console.log('\n🔍 Checking if batch should continue...');

        const state = JSON.parse(sessionStorage.getItem('batch_state') || 'null');

        if (!state) {
            console.log('   No state found');
            return;
        }

        console.log(`   State found: running=${state.running}, completed=${state.completed}, mode=${state.mode}`);
        console.log(`   Remaining items: ${(state.remainingSlugs || state.remainingLinks || []).length}`);

        if (state.completed) {
            console.log('   ✅ Batch is complete! Showing completion panel.');
            updateControlPanel();
            return;
        }

        if (state && state.running) {
            const remaining = state.remainingSlugs || state.remainingLinks || [];
            if (remaining.length > 0) {
                console.log('   ✅ Batch should continue!');
                console.log(`   Next item: ${remaining[0]?.slug || remaining[0]}`);
                console.log('   Starting in 1.5 seconds...\n');

                createBackgroundOverlay();
                updateControlPanel();

                setTimeout(() => {
                    console.log('⏰ Time passed, calling run()...');
                    run();
                }, 1500);
            } else {
                console.log('   ⏸️ No items left');
                updateControlPanel();
            }
        } else {
            console.log('   ⏸️ Batch not running');
            updateControlPanel();
        }
    }

