        console.log(`✓ Found button: "${editBtn.textContent.trim()}"`);
        console.log('🖱️ Clicking...');
        editBtn.click();

        console.log('⏳ Waiting for modal to appear (800ms)...');
        await new Promise(r => setTimeout(r, 800));

        console.log('\n🔍 Step 2: Finding URL input field in modal...');

        let urlInput = null;

        // Try multiple methods to find the input
        urlInput = document.querySelector('input[name="destination"]');
        if (urlInput) console.log('✓ Found by name="destination"');

        if (!urlInput) {
            const inputs = document.querySelectorAll('input[type="text"], input[type="url"], input:not([type="hidden"])');
            console.log(`Found ${inputs.length} visible input fields`);
            inputs.forEach((inp, i) => {
